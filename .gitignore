.env
.env.local
.memory/
node_modules/
.next/
__pycache__/
*.pyc
.venv
backend/downloads/
.DS_Store
db/backups/

# TypeScript incremental build cache
*.tsbuildinfo

# Editor swap files
*.swp
*.swo

# Agent skills installed with `npx skills` — tooling, not application code.
# No trailing slash on this or .venv above: a dev-harness sandbox symlinks both
# into its worktree, git treats a symlink as a file, and `.agents/` would not
# match it — so every sandbox would be born with an untracked file.
.agents
skills-lock.json

# Per-entry, not `.claude/skills/`: git never descends into an excluded
# directory, so a `!` negation after a directory exclude could never match.
# Installed skills stay ignored; first-party ones are committed one by one.
.claude/skills/*
!.claude/skills/sandbox/

# Vercel CLI link (contains projectId/orgId)
.vercel

# Per-worktree sandbox manifest written by scripts/sandbox.sh (slot and ports,
# no secrets). It is deleted with the worktree, which is what keeps slot
# allocation derived rather than held in a registry that drifts.
.sandbox
