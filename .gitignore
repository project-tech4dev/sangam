.env
.env.local
.memory/
node_modules/
.next/
__pycache__/
*.pyc
.venv
backend/downloads/
.DS_Store
db/backups/

# TypeScript incremental build cache
*.tsbuildinfo

# Editor swap files
*.swp
*.swo

# Agent skills installed with `npx skills`. No trailing slash here or on .venv:
# git treats a symlink as a file, and a sandbox symlinks both into its worktree.
.agents
skills-lock.json

# Per-entry: git never descends into an excluded directory, so a `!` negation
# after a directory exclude could never match. First-party skills are committed.
.claude/skills/*
!.claude/skills/sandbox/

# Vercel CLI link (contains projectId/orgId)
.vercel

# Per-worktree manifest from scripts/sandbox.sh: slot and ports, no secrets.
# It dies with the worktree, which is what keeps slot allocation derived.
.sandbox
