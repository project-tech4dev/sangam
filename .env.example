# Copy to .env and fill in. docker-compose reads this file automatically.
#
# Docker is for LOCAL DEVELOPMENT ONLY. Deployed environments (Vercel for the
# frontend, a container host for the backend) get their variables from their own
# dashboards — this file is not shipped anywhere.
#
# The DB_* blocks below are per-environment. Local is the default; the staging
# block is used by `make <target> ENV=staging`, which runs local Docker tooling
# against the managed database (migrations, seeding, psql).

# --- Required ---
# The one API key matching MODEL's provider.
ANTHROPIC_API_KEY=

# =============================================================================
# LOCAL — the bundled Postgres container in docker-compose.yml
# =============================================================================
LOCAL_DB_HOST=postgres
LOCAL_DB_PORT=5432
LOCAL_DB_USER=sangam
LOCAL_DB_PASSWORD=sangam
LOCAL_DB_NAME=sangam
LOCAL_DB_SSLMODE=prefer
# Optional: a full connection string that overrides the six parts above.
LOCAL_DATABASE_URL=

# Starts the bundled Postgres container. Comment out to run against a managed
# database instead (nothing else in the stack changes).
COMPOSE_PROFILES=localdb

# =============================================================================
# STAGING — managed Postgres (Supabase, Neon, RDS…)
# =============================================================================
# Copy these from your provider's dashboard. Used by:
#     make migrate ENV=staging
#     make seed    ENV=staging
#     make psql    ENV=staging
#
# The role needs CREATE on the public schema: this database holds application
# data AND the LangGraph chat checkpoints, whose tables are created at boot.
# The instance needs the `vector` and `pg_trgm` extensions available (Supabase
# and Neon both ship them).
STAGING_DB_HOST=
STAGING_DB_PORT=5432
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_NAME=postgres
STAGING_DB_SSLMODE=require
# Optional: paste the provider's connection string here instead of the parts.
# If it is a URL, percent-encode any @ : / ? # in the password.
STAGING_DATABASE_URL=

# =============================================================================
# Supabase Storage (optional) — the document archive and the org Doc Vault
# =============================================================================
# Two private buckets, created by db/migrations/0020_storage_buckets.sql:
#   source-archive   PDFs the research agent fetched, kept so a fact survives
#                    its source URL going 404
#   org-vault        what an organisation uploads about itself (DPDP-governed)
#
# Unset = archiving is skipped and the upload routes return 503. Research,
# promotion and everything else run unchanged, so local development needs none
# of this. See docs/features/2026-09-30-supabase-storage.md.
#
# SUPABASE_URL is the project API URL (https://<ref>.supabase.co), NOT the
# database host — different thing from STAGING_DB_HOST above.
SUPABASE_URL=
# The SERVICE ROLE key, from Project Settings → API. It bypasses row-level
# security completely, so it stays server-side: never NEXT_PUBLIC_, never sent
# to the browser. The browser gets short-lived signed URLs minted by the
# backend instead.
SUPABASE_SERVICE_KEY=

# =============================================================================
# Knowledge graph
# =============================================================================
# Local: the bundled neo4j container. Deployed: a hosted instance (Neo4j Aura).
# Graph features stay off entirely when NEO4J_URI or OPENAI_API_KEY is unset.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sangamneo4j

# =============================================================================
# CORS — only matters for deployed environments (see docs/DEPLOY.md)
# =============================================================================
# Exact origins allowed to call the backend from a browser.
ALLOWED_ORIGINS=http://localhost:3000
# Vercel gives every preview deployment a fresh hostname, which an exact-match
# list cannot cover. ANCHOR the pattern with ^ and $ — unanchored, it would also
# match https://sangam-x.vercel.app.attacker.com.
#   ALLOWED_ORIGIN_REGEX=^https://sangam-[a-z0-9-]+\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# --- Optional ---
# "provider:model_name" — anthropic | openai | google_genai
MODEL=anthropic:claude-sonnet-5
# Powers Graphiti's entity extraction and embeddings, and so gates the graph.
# Anthropic has no embedding models, which is why this is a separate key.
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Enables the agent's web-search tool when set.
TAVILY_API_KEY=
# A cheap second opinion on each SQL answer: does the query count the entity the
# question asked about, is every filter present, could a zero mean a wrong filter
# VALUE, do the figures in the answer match the rows. It appends a caveat and
# never blocks. Empty = off. This is a real extra model call per SQL turn, so
# point it at the cheapest model of a provider you already have a key for.
#   SQL_AUDIT_MODEL=anthropic:claude-haiku-4-5
SQL_AUDIT_MODEL=

# Work in the importer that needs no reasoning: the India CSR extractor
# filling a fixed record shape from one article, and the catalog-writer
# subagent, which calls two tools and formats what they return. Empty falls
# back to MODEL, so leaving it unset changes nothing.
#   UTILITY_MODEL=anthropic:claude-haiku-4-5
UTILITY_MODEL=
# How many organisations Sangam Import researches AT ONCE. Not a cap on how many
# you may ask for — above this it works in waves until the whole list is done.
# Raise both of these together: each researcher holds a pooled connection while
# its tools run, and more researchers than connections means every wave queues.
# The ceiling is the database's: the Supabase project allows 60 connections with
# 3 reserved, and a deployed backend runs several instances.
MAX_PARALLEL_RESEARCH=8
DB_POOL_MAX_SIZE=10
# Langfuse tracing (optional): agent runs → traces/tokens/costs.
# Both LANGFUSE_BASE_URL and LANGFUSE_HOST are read, and BASE_URL wins when both
# are set — HOST is the older alias. Neither set → the cloud endpoint below.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Separates traces in the Langfuse UI. Without it every environment writes to
# the same bucket and local experiments sit next to production traffic.
LANGFUSE_TRACING_ENVIRONMENT=local
# Optional: stamps each trace with the build it came from, e.g. a git sha.
LANGFUSE_RELEASE=
# Redacts query results from the db_query span. The SQL, tool inputs and row
# counts are still recorded. A reduction, not a guarantee — the same rows also
# reach the model, so they appear in generation inputs regardless. Run Langfuse
# inside your own deployment; that is the real control.
LANGFUSE_MASK_TOOL_RESULTS=

# LangSmith tracing (optional, and independent of Langfuse — both can run).
# A LangGraph app needs no code to be traced: these variables switch the tracer
# on, and each agent's run_name (sangam_ask / sangam_import) names the root run.
# Both must be set; the backend says at boot which of the two is missing.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
# Which project traces land in. Without it everything goes to "default".
LANGSMITH_PROJECT=sangam
# Only for self-hosted LangSmith; the SDK defaults to api.smith.langchain.com.
LANGSMITH_ENDPOINT=
