# Copy to .env and fill in. docker-compose reads this file automatically.

# --- Required ---
# The one API key matching MODEL's provider.
ANTHROPIC_API_KEY=

# --- Optional ---
# "provider:model_name" — anthropic | openai | google_genai
MODEL=anthropic:claude-sonnet-5
# Also enables the Graphiti knowledge graph (extraction LLM + embeddings) —
# graph features stay off without it. Anthropic has no embedding models.
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Enables the agent's web-search tool when set.
TAVILY_API_KEY=
# Local Postgres password (defaults to "sangam").
POSTGRES_PASSWORD=
# Langfuse tracing (optional): agent runs → traces/tokens/costs.
# Create a project at https://cloud.langfuse.com (or self-host) and paste keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
