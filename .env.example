# Copy to .env and fill in. docker-compose reads this file automatically.
#
# Docker is for LOCAL DEVELOPMENT ONLY. Deployed environments (Vercel for the
# frontend, a container host for the backend) get their variables from their own
# dashboards — this file is not shipped anywhere.
#
# The DB_* blocks below are per-environment. Local is the default; the staging
# block is used by `make <target> ENV=staging`, which runs local Docker tooling
# against the managed database (migrations, seeding, psql).

# --- Required ---
# The one API key matching MODEL's provider.
ANTHROPIC_API_KEY=

# =============================================================================
# LOCAL — the bundled Postgres container in docker-compose.yml
# =============================================================================
LOCAL_DB_HOST=postgres
LOCAL_DB_PORT=5432
LOCAL_DB_USER=sangam
LOCAL_DB_PASSWORD=sangam
LOCAL_DB_NAME=sangam
LOCAL_DB_SSLMODE=prefer
# Optional: a full connection string that overrides the six parts above.
LOCAL_DATABASE_URL=

# Starts the bundled Postgres container. Comment out to run against a managed
# database instead (nothing else in the stack changes).
COMPOSE_PROFILES=localdb

# =============================================================================
# STAGING — managed Postgres (Supabase, Neon, RDS…)
# =============================================================================
# Copy these from your provider's dashboard. Used by:
#     make migrate ENV=staging
#     make seed    ENV=staging
#     make psql    ENV=staging
#
# The role needs CREATE on the public schema: this database holds application
# data AND the LangGraph chat checkpoints, whose tables are created at boot.
# The instance needs the `vector` and `pg_trgm` extensions available (Supabase
# and Neon both ship them).
STAGING_DB_HOST=
STAGING_DB_PORT=5432
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_NAME=postgres
STAGING_DB_SSLMODE=require
# Optional: paste the provider's connection string here instead of the parts.
# If it is a URL, percent-encode any @ : / ? # in the password.
STAGING_DATABASE_URL=

# =============================================================================
# Knowledge graph
# =============================================================================
# Local: the bundled neo4j container. Deployed: a hosted instance (Neo4j Aura).
# Graph features stay off entirely when NEO4J_URI or OPENAI_API_KEY is unset.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sangamneo4j

# =============================================================================
# CORS — only matters for deployed environments (see docs/DEPLOY.md)
# =============================================================================
# Exact origins allowed to call the backend from a browser.
ALLOWED_ORIGINS=http://localhost:3000
# Vercel gives every preview deployment a fresh hostname, which an exact-match
# list cannot cover. ANCHOR the pattern with ^ and $ — unanchored, it would also
# match https://sangam-x.vercel.app.attacker.com.
#   ALLOWED_ORIGIN_REGEX=^https://sangam-[a-z0-9-]+\.vercel\.app$
ALLOWED_ORIGIN_REGEX=

# --- Optional ---
# "provider:model_name" — anthropic | openai | google_genai
MODEL=anthropic:claude-sonnet-5
# Powers Graphiti's entity extraction and embeddings, and so gates the graph.
# Anthropic has no embedding models, which is why this is a separate key.
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Enables the agent's web-search tool when set.
TAVILY_API_KEY=
# Langfuse tracing (optional): agent runs → traces/tokens/costs.
# Both LANGFUSE_BASE_URL and LANGFUSE_HOST are read, and BASE_URL wins when both
# are set — HOST is the older alias. Neither set → the cloud endpoint below.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Separates traces in the Langfuse UI. Without it every environment writes to
# the same bucket and local experiments sit next to production traffic.
LANGFUSE_TRACING_ENVIRONMENT=local
# Optional: stamps each trace with the build it came from, e.g. a git sha.
LANGFUSE_RELEASE=
