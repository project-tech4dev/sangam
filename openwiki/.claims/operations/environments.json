          "version": "repo-lines-v1:sha256:d12488efc13fb4397552cf4810debf319faedc85d066a407d5c9318dea6d6caf:"
        }
      ]
    },
    {
      "id": "claim_207a62d2b1b446acaa7c86af136fe802",
      "statement": "The staging overlay redefines only the backend DATABASE_URL from STAGING_DATABASE_URL or the STAGING_DB_* parts, using :? guards on host, user and password so an empty staging block fails fast instead of connecting to localhost; scripts/db-url.sh resolves the effective URL via 'compose config' so compose is the single source of truth for the connection string.",
      "evidence": [
        {
          "resource": "repo://Makefile#L42-L46",
          "version": "repo-lines-v1:sha256:598f1ee12bb168fcf32161f52fedc3cace61ce731fc2a11d0e48328571348803:"
        },
