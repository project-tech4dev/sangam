    {
      "id": "claim_272447998d234309a6054aa500636495",
      "statement": "ENV is a Make variable defaulting to local; ENV=staging layers docker-compose.staging.yml over docker-compose.yml, any other value is a make error, and ENV only changes which Postgres the local Docker tooling and containers use (it deploys nothing).",
      "evidence": [
        {
          "resource": "repo://Makefile#L25-L40",
          "version": "repo-lines-v1:sha256:bef108313170c9d812dae5ebb9a2d83b2364379f8a059768711f2d54c70c7779:"
        },
        {
