        }
      ]
    },
    {
      "id": "claim_38f7d678da6547fb93eb2e64d11b8838",
      "statement": "The local backend DATABASE_URL is built in keyword/value form from LOCAL_DB_* parts (overridable by LOCAL_DATABASE_URL, with POSTGRES_PASSWORD as legacy fallback), so passwords need no percent-encoding; the bundled Postgres only starts under the localdb compose profile and the backend's dependency on it is required:false so a managed DB can replace it.",
      "evidence": [
        {
          "resource": "repo://.env.example#L15-L30",
