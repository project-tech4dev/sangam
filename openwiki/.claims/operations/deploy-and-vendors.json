    {
      "id": "claim_e242e3585d294b8eb5d10b7908f03732",
      "statement": "The deployed backend must connect to Supabase Postgres through the session pooler on port 5432: the direct host `db.<ref>.supabase.co` is IPv6-only and hangs from containers, and the transaction pooler (6543) breaks pg_restore. The backend pool also disables prepared statements (`prepare_threshold=0`).",
      "evidence": [
        {
          "resource": "repo://CLAUDE.md#L545-L550",
