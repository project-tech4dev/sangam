    {
      "id": "claim_b42b960e92ba4e16aa4f851a9074db0d",
      "statement": "SUPABASE_URL is the auth switch: when set, the backend verifies Supabase access tokens against the project's JWKS (ES256/RS256, audience `authenticated`, issuer `<url>/auth/v1`) and anonymous requests have no identity; when empty every request is the seeded dev user, and `Bearer dev` is accepted only with DEV_AUTH.",
      "evidence": [
        {
          "resource": "repo://.env.example#L65-L76",
