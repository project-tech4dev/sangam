    {
      "id": "claim_5d2d3bc806144b839a41d0dd77628ca1",
      "statement": "The backend's Postgres pool size (DB_POOL_MAX_SIZE, default 10) is sized against Supabase's 60-connection limit (3 reserved) across several instances, is shared by REST, agent tools and the checkpointer, and concurrency gates are set to max(2, pool-3).",
      "evidence": [
