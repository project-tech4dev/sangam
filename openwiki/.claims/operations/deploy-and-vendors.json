    {
      "id": "claim_195163c880b540f69abd70548853633d",
      "statement": "Production deploys happen only through the manually triggered (workflow_dispatch) Deploy GitHub workflow, which runs `vercel deploy --prod` for the `sangam` and `sangam-backend` projects using VERCEL_TOKEN; with no usable base ref a manual run deploys both.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/deploy.yml#L1-L86",
          "version": "repo-lines-v1:sha256:24549f7d482f19fb01d08c3204a950495afe290ac099c7fb34d3d9f1f2228283:"
        }
