    {
      "id": "claim_cbf4cc986efa451fb08f51996cdbb613",
      "statement": "Both Vercel projects (frontend `sangam`, backend `sangam-backend`) disable Git-triggered deployments via `git.deploymentEnabled: false` in their vercel.json and pin the function region to `bom1` (Mumbai), beside the Supabase database.",
      "evidence": [
        {
          "resource": "repo://backend/vercel.json#L1-L7",
          "version": "repo-lines-v1:sha256:00c997befdccf691f5f689d2d9108943e7eb28088e2cf3ae55338cdfc7c45620:"
