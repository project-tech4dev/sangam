  "claims": [
    {
      "id": "claim_d9daf5b01f3647079a608efffbedf03c",
      "statement": "Nothing deploys automatically: both frontend/vercel.json and backend/vercel.json set git.deploymentEnabled to false, and the Deploy workflow's only trigger is workflow_dispatch, so merges and pushes build nothing and there are no preview deployments.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/deploy.yml#L1-L6",
          "version": "repo-lines-v1:sha256:02eff0c0eb1b7836a7b1a88dd4b2fdd32c8e3bfa63ee912de6fe0a019e673307:"
