    {
      "id": "claim_e0c3208ddc39467e9dc38d04a2eb3c07",
      "statement": "The workflow uses concurrency group deploy-${{ github.ref }} with cancel-in-progress false, so a second dispatch on the same ref queues and a production deploy is never cancelled mid-flight.",
