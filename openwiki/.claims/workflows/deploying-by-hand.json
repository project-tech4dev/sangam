    {
      "id": "claim_f8b5b60395af41988a42cc513238a44c",
      "statement": "ENV=staging selects the docker-compose.staging.yml overlay, which builds the backend container's DATABASE_URL from STAGING_DATABASE_URL or the STAGING_DB_* variables in .env (sslmode defaulting to require) with :? guards that fail fast when unset; make up skips its automatic migrate for non-local ENV, so migrating the managed database stays an explicit make migrate ENV=staging.",
      "evidence": [
        {
          "resource": "repo://.env.example#L31-L51",
