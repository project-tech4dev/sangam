    {
      "id": "claim_7bc16f9c4a024d198af29fd93e9c787c",
      "statement": "catalog.py runs _self_check() at import, rejecting catalogued tables with no columns or primary key, primary/foreign key columns not listed, foreign keys referencing tables or columns missing from the catalog, and columns with an unknown cites kind; KNOWN_EXCLUDED holds tables intentionally outside the catalog, including chat checkpoints, users, threads, org_members, proposals, funder_matches, vault_research, promotions, catalog_writes, deleted_documents, news pipeline state, ingest bookkeeping and schema_migrations.",
      "evidence": [
