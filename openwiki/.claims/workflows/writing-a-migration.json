  "claims": [
    {
      "id": "claim_163b637ead7644f9b6ecbe76acd3baf7",
      "statement": "The migration runner sorts db/migrations/*.sql by filename, records the full file stem plus a SHA-256 checksum prefix in schema_migrations, and runs each pending file in its own transaction together with its ledger insert; on any error it rolls back that file, reports it, and stops without attempting later files.",
      "evidence": [
        {
          "resource": "repo://backend/app/db/migrate.py#L29-L95",
          "version": "repo-lines-v1:sha256:219c152db7b361a41d3b5969759122bb0c23cab2820e5106bec7bcea8260cd0e:"
        },
        {
          "resource": "repo://db/migrations/README.md#L13-L25",
          "version": "repo-lines-v1:sha256:1e4e7f826c1fc402bac8e2b31db41bee14ee3520e44951cd43bd7503ea24b3d7:"
        }
      ]
    },
    {
      "id": "claim_8d5c085561da425bbd994d047c67ae13",
      "statement": "If an already-applied migration file's checksum differs from the recorded one, the runner prints a DRIFT warning and skips it rather than failing; the convention is never to edit applied files and to write a new migration instead.",
      "evidence": [
        {
          "resource": "repo://backend/app/db/migrate.py#L57-L68",
          "version": "repo-lines-v1:sha256:73e6e12dc8cc6b667488d5cfdfebb41c303072196b9b715d52d7f9c6642f3159:"
