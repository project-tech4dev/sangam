          "version": "repo-lines-v1:sha256:4b4602c19fe312f8a38c64d8c1dcea135ae8e35c6ead86a8af1b86dd87a686e8:"
        }
      ]
    },
    {
      "id": "claim_08cefe6885f1479183162ef0758eb0a0",
      "statement": "org_identifiers is granted by column, so a new column on it needs an explicit GRANT SELECT (col) ON org_identifiers TO anon, authenticated to be readable.",
