  "claims": [
    {
      "id": "claim_163b637ead7644f9b6ecbe76acd3baf7",
      "statement": "The migration runner sorts db/migrations/*.sql by filename, records the full file stem plus a SHA-256 checksum prefix in schema_migrations, and runs each pending file in its own transaction together with its ledger insert; on any error it rolls back that file, reports it, and stops without attempting later files (and without running the checkpointer step).",
      "evidence": [
        {
          "resource": "repo://backend/app/db/migrate.py#L29-L31",
          "version": "repo-lines-v1:sha256:eaeec043a3c547665e444fdd38a1134dff9573b36a8a59bd995ae304d8f6b77c:"
        },
        {
          "resource": "repo://backend/app/db/migrate.py#L51-L120",
          "version": "repo-lines-v1:sha256:307fc786f2af29b1c74db59994bf41b66f8e45394309f112b0a344afdcc32f47:"
        },
        {
          "resource": "repo://db/migrations/README.md#L13-L25",
          "version": "repo-lines-v1:sha256:1e4e7f826c1fc402bac8e2b31db41bee14ee3520e44951cd43bd7503ea24b3d7:"
        }
      ]
    },
    {
      "id": "claim_8d5c085561da425bbd994d047c67ae13",
      "statement": "If an already-applied migration file's checksum differs from the recorded one, the runner prints a DRIFT warning and skips it rather than failing; the convention is never to edit applied files and to write a new migration instead.",
