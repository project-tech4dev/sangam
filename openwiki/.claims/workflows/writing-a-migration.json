    {
      "id": "claim_aad2169e729a47c7ab9a750d0d0256a1",
      "statement": "At backend boot, the lifespan's _verify_sql_catalog calls verify_against_db and raises RuntimeError if it reports any problem: a catalogued table or column absent from the database, or a catalogued column that authenticated cannot SELECT (or that anon can read only in part of a table). Extra live tables not in the catalog or KNOWN_EXCLUDED are only logged at INFO and extra columns are not checked, so a new table stays invisible to the agent until deliberately catalogued or excluded.",
      "evidence": [
        {
          "resource": "repo://backend/app/agent/tools/sql/catalog.py#L1002-L1042",
          "version": "repo-lines-v1:sha256:d42153d2631967d5f541b71055f393d5ace9794a498d18671720e9ce072ede62:"
