          "version": "repo-lines-v1:sha256:39fae284412064436efafde4ff1a25987fa4d8ed434273afba0c91a43a731f1a:"
        }
      ]
    },
    {
      "id": "claim_d3789f0c78804e9dbcc08644c4c111df",
      "statement": "make migrate and make migrate-status run python -m app.db.migrate in a one-off backend container selected by ENV (local or staging); migrate-status passes --status and reports pending files without applying them. The runner reads db/migrations from the /srv/db mount.",
