# Copy to .env.local and fill in. Next.js reads it from this folder only.
#
# Both values are from the Supabase dashboard: Project Settings → API.
# NEXT_PUBLIC_* is inlined at build time — on Vercel, set these in the
# project's environment variables and redeploy after changing them.

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
