# Dev-mode container: source arrives via bind mount, deps via the entrypoint,
# which installs only when package.json/package-lock.json change.
FROM node:22-alpine

WORKDIR /app

# Copied only so the image changes when the manifests do — that is what makes
# compose recreate the container and run the entrypoint. Shadowed at runtime.
COPY package.json package-lock.json ./

COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/

EXPOSE 3000
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
