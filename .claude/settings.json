{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(bat .env*)",
      "Bash(nano .env*)",
      "Bash(vim .env*)",
      "Bash(open .env*)"
    ]
  }
}
